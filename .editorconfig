# EditorConfig - FlutterCPAC
# https://editorconfig.org

root = true

# Todos los archivos
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Dart
[*.dart]
indent_size = 2

# Markdown (no trim trailing whitespace)
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yaml,yml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Makefile
[Makefile]
indent_style = tab

# Git files
[*.gitignore]
trim_trailing_whitespace = false

# Flutter/Dart specific
[{pubspec.yaml,pubspec.lock}]
indent_size = 2
